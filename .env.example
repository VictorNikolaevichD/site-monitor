# App
APP_PORT=8080
GRPC_PORT=9090
LOG_LEVEL=info
CHECK_INTERVAL=60s
HTTP_TIMEOUT=10s
GATEWAY_PORT=8082

# DB parts (Compose builds DATABASE_URL from these)
DB_HOST=postgres
DB_USER=monitor
DB_PASSWORD=monitor
DB_NAME=site_monitor_db
DB_SSLMODE=disable
DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:5432/${DB_NAME}?sslmode=${DB_SSLMODE}
MIGRATE_DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@localhost:5433/${DB_NAME}?sslmode=${DB_SSLMODE}

# Host publish port for Postgres (IDE). 5432 on a clean machine, 5433 if busy.
POSTGRES_PORT=5433

# Kafka
KAFKA_BROKER=kafka:29092
KAFKA_TOPIC=site-check-events

# Notification
KAFKA_GROUP_ID=notification-service

NOTIFICATION_HTTP_ADDR=:8081
NOTIFICATION_LOG_LEVEL=info
NOTIFICATION_TG_BOT_TOKEN=your-telegram-bot-token
NOTIFICATION_TG_CHAT_ID=123123123123
